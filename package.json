{
  "name": "@omnedia/ngx-three-globe",
  "description": "A simple component library to create a container with an animated and interactive globe.",
  "version": "4.0.1",
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "three-globe": "^2.42.11",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "three": "file:../three.js"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "exports": {
    ".": {
      "types": "./public-api.d.ts",
      "browser": "./fesm2022/ngx-three-globe.mjs",
      "default": "./server/fesm2022/ngx-three-globe-server.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./server": {
      "types": "./server/public-api.d.ts",
      "default": "./server/fesm2022/ngx-three-globe-server.mjs"
    },
    "./browser": {
      "types": "./browser/public-api.d.ts",
      "default": "./browser/fesm2022/ngx-three-globe-browser.mjs"
    }
  },
  "sideEffects": false,
  "keywords": [
    "npm",
    "globe",
    "3d",
    "threejs",
    "interactive",
    "animation"
  ],
  "repository": {
    "url": "https://github.com/omnedia/ngx-three-globe"
  },
  "author": "Markus Block (markus.block@omnedia.com)",
  "license": "MIT"
}
